# Copy to .env (never commit .env)
DATABASE_URL=postgresql://user:password@host:5432/postgres
DIRECT_URL=postgresql://user:password@host:5432/postgres

# Required, >= 32 chars, random, and different from each other (server refuses to start otherwise)
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_EXPIRATION=30d

NODE_ENV=production
PORT=5000

# Reverse proxy: 'loopback' (default, nginx on same host), a hop count like 1, or IP/CIDR list
TRUST_PROXY=loopback
# Optional: comma-separated browser origins allowed by CORS (unset = open)
CORS_ORIGINS=
# Optional: days to keep non-login audit rows (default 180)
AUDIT_LOG_RETENTION_DAYS=180

# Only for src/scripts/seedAdmin.ts
ADMIN_SEED_PHONE=
ADMIN_SEED_PASSWORD=
