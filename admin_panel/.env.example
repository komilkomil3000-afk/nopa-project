PORT=5000
# Self-hosted Supabase (Supavisor pooler). Replace <TENANT>, <PASSWORD>, <SERVER_IP>.
DATABASE_URL="postgresql://postgres.<TENANT>:<PASSWORD>@<SERVER_IP>:6543/postgres?pgbouncer=true&connection_limit=10"
# Direct (session) connection used by prisma migrate
DIRECT_URL="postgresql://postgres.<TENANT>:<PASSWORD>@<SERVER_IP>:5432/postgres"
JWT_SECRET="your_jwt_secret"
JWT_EXPIRATION="30d"
