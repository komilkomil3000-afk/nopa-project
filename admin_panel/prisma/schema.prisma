datasource db {
  provider = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id                           String         @id @default(uuid())
  phoneNumber                  String
  passwordHash                 String
  role                         String         // "student" | "mentor" | "admin"
  name                         String
  avatarUrl                    String?        // picked in the app (bundled "asset:<key>" or an upload)
  siteAvatarUrl                String?        // set by the admin panel; shown on the site instead of avatarUrl
  gender                       String?        // "male" | "female"
  panelAccess                  Boolean?       // null = follow role default; true/false = per-user override
  zarikBalance                 Int            @default(0)
  levelFrame                   Int            @default(1)
  completedStationsHigh        Int            @default(0) // most stations ever completed; editing content never locks passed stations
  mentorLevel                  Int            @default(1) // 1: Junior, 2: Senior, 3: Master
  nationalId                   String?
  dateOfBirth                  String?
  email                        String?
  totalTransactions            Int            @default(0)
  totalZarikPurchases          Int            @default(0)
  identityVerified             Boolean        @default(false)
  lastActiveTimestamp          DateTime       @default(now())
  caravanId                    String?
  hasEvaluatedMentorThisSeason Boolean        @default(false)
  createdAt                    DateTime       @default(now())
  blocked                      Boolean        @default(false)
  isDualRole                   Boolean        @default(false) // True if user is both Student and Mentor

  // Security & Billing Additions
  tokenVersion                 Int            @default(0)
  failedLoginAttempts          Int            @default(0)
  lockoutUntil                 DateTime?
  hasPrePaidClasses            Boolean        @default(true)
  countryCode                  String         @default("+98")
  registrationCompleted        Boolean        @default(false)
  userCode                     Int?           @unique
  isDeleted                    Boolean        @default(false)
  deletedAt                    DateTime?
  suspendedUntil               DateTime?
  sessions                     UserSession[]

  // Mentor Demographics & Tangible Assets
  city                           String?
  bio                            String?
  slogan                         String?  // short line (max 30 chars) shown in chat profiles
  academicDegree                 String?
  academicCertificates           String?
  accountStatus                  String         @default("ACTIVE") // ACTIVE, SUSPENDED, RESTRICTED, PENDING_VERIFICATION
  socialMessengerHandle          String?
  socialPlatform                 String?
  nakh                           Int            @default(0)
  beyragh                        Int            @default(0)
  farsh                          Int            @default(0)

  // Relations
  certificates                 Certificate[]
  physicalOrders               PhysicalCertificateOrder[]
  caravan                      Caravan?       @relation("CaravanMembers", fields: [caravanId], references: [id], onDelete: SetNull)
  mentoredCaravans             Caravan[]      @relation("MentorCaravans")
  mentorDocuments              MentorDocument[]
  submissions                  Submission[]
  usageDays                    UserUsageDay[]
  activityHours                UserActivityHour[]
  videoWatches                 VideoWatch[]
  activityLogs                 UserActivityLog[]
  quizSubmissions              QuizSubmission[] @relation("StudentQuizSubmissions")
  quizReviews                  QuizSubmission[] @relation("MentorQuizReviews")
  formSubmissions              FormSubmission[]

  ratingsGiven                 MentorRating[] @relation("RatingStudent")
  ratingsReceived              MentorRating[] @relation("RatingMentor")
  notifications                Notification[]
  zarikTransactions            ZarikTransaction[]
  adminMessages                AdminMessage[]
  chatMessages                 ChatMessage[]
  chatMemberships              ChatMember[]
  supportCases                 SupportCase[]
  supportTickets               SupportTicket[] @relation("TicketStudent")
  supportReplies               SupportTicketReply[] @relation("ReplyMentor")
  assetConversions             AssetConversionRequest[]
  mentorFeedbacks              MentorFeedback[] @relation("MentorFeedbacks")
  sessionWatchRecords          SessionWatchRecord[]
  videoBookmarks               VideoBookmark[]

  evaluationsGiven             MentorEvaluation[] @relation("EvaluationsStudent")
  evaluationsReceived          MentorEvaluation[] @relation("EvaluationsMentor")
  studentNotes                 PrivateStudentNote[] @relation("StudentNotes")
  mentorNotesWritten           PrivateStudentNote[] @relation("MentorNotes")
  userProgress                 UserProgress[]

  @@index([phoneNumber])
  @@index([role])
  @@index([caravanId])
  @@index([zarikBalance])
  @@index([createdAt])
  assetTransactions AssetTransaction[]
}

model UserSession {
  id         String   @id @default(uuid())
  userId     String
  token      String   @unique
  deviceInfo String?
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
}

model Caravan {
  id              String  @id @default(uuid())
  name            String
  mentorId        String?
  memberCount     Int     @default(0)
  overallProgress Float   @default(0.0)
  groupPoints     Int     @default(0)
  status          String  @default("active") // "active" | "suspended"
  capacityLimit   Int     @default(25)
  socialGroupLink String?
  isDeleted       Boolean @default(false)
  deletedAt       DateTime?

  description     String?
  coverImageUrl   String?
  slogan          String?  // short line (max 30 chars), set by the mentor
  targetStationId String?

  // Relations
  mentor          User?         @relation("MentorCaravans", fields: [mentorId], references: [id], onDelete: SetNull)
  members         User[]        @relation("CaravanMembers")
  chatSpaces      ChatSpace[]
  assetConversions AssetConversionRequest[]
  challenges      Challenge[]
  banners         CaravanBanner[]
}

model SystemSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model AssetConversionRequest {
  id              String   @id @default(uuid())
  caravanId       String
  requestedBy     String
  status          String   @default("completed") // "completed" | "cancelled" (legacy: "pending" | "approved" | "rejected")
  sourceAsset     String?
  targetAsset     String?
  sourceAmount    Int?
  targetAmount    Int?
  cancelledBy     String?
  cancelledAt     DateTime?
  note            String?
  rejectionReason String?
  reviewedAt      DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  caravan         Caravan  @relation(fields: [caravanId], references: [id], onDelete: Cascade)
  user            User     @relation(fields: [requestedBy], references: [id], onDelete: Cascade)

  @@index([caravanId])
  @@index([requestedBy])
  @@index([status])
}

model Challenge {
  id                String       @id @default(uuid())
  title             String
  description       String
  type              String       // "quiz" | "skill" | "file"
  questions         String?      // JSON string representation of questions
  rewardZarik       Int          @default(0)
  rewardAssetType   String       @default("zarik") // "zarik" | "nakh": what an approved answer pays out
  rewardMin         Int          @default(0)       // range the reviewing mentor picks from; 0/0 = fixed rewardZarik
  rewardMax         Int          @default(0)
  category          String       @default("intra_group") // "intra_group" | "inter_group" | "individual"
  recipientIds      String[]     @default([])             // empty = every member of the caravan; else only these students
  createdByMentorId String
  caravanId         String?
  stationId         String?
  rankingFinalizedAt DateTime?                              // inter-group: when the admin confirmed the caravans' ranking
  judgingStartedAt  DateTime?                                // inter-group: works are final and judges can read them
  rewardPlan        Json?                                    // inter-group: the admin's per-member base reward by rank, { zarik: {gold,silver,bronze,cloth}, nakh: {...} }; null = the money rules' defaults
  startDate         DateTime?                                // challenge opens at this moment (null = already open)
  dueDate           DateTime?
  createdAt         DateTime     @default(now())

  // Relations
  caravan           Caravan?     @relation(fields: [caravanId], references: [id], onDelete: SetNull)
  station           Station?     @relation(fields: [stationId], references: [id], onDelete: SetNull)
  submissions       Submission[]
  chatTopics        ChatTopic[]

  @@index([caravanId])
  @@index([stationId])
  @@index([createdByMentorId])
}

model Submission {
  id             String    @id @default(uuid())
  challengeId    String
  studentId      String
  answerText     String?
  fileUrl        String?
  status         String    @default("pending") // "pending" | "approved" | "rejected"
  score          Int       @default(0)
  mentorFeedback String?
  quizAnswers    Json?     // quiz: the option picked for each question (-1 = blank), graded on the server
  submittedAt    DateTime  @default(now())

  // Relations
  challenge      Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  student        User      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  events         SubmissionEvent[]

  @@unique([challengeId, studentId])
  @@index([studentId])
  @@index([status])
}

// Every answer, rejection (with the mentor's message) and approval of a submission, kept after the row is overwritten by a re-submit
model SubmissionEvent {
  id           String     @id @default(uuid())
  submissionId String
  challengeId  String
  studentId    String
  action       String     // "submitted" | "rejected" | "approved"
  answerText   String?
  fileUrl      String?
  feedback     String?
  score        Int?
  actorId      String?
  actorName    String?
  createdAt    DateTime   @default(now())

  submission   Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@index([submissionId, createdAt])
  @@index([challengeId])
}

// Display names of the assets (editable from the admin panel); the app reads them at start
model AssetType {
  key       String   @id // "zarik" | "nakh" | "farsh" | "derafsh" | "derafsh_gold" | "derafsh_silver" | "derafsh_bronze" | "derafsh_cloth"
  nameFa    String
  sortOrder Int      @default(0)
  updatedAt DateTime @updatedAt
}

// Banner (درفش) won by a caravan in an inter-group challenge; the caravan owns them, not its members
model CaravanBanner {
  id          String   @id @default(uuid())
  caravanId   String
  tier        String   // "gold" | "silver" | "bronze" | "cloth"
  rank        Int?     // 1..3 for the medals, null for cloth
  challengeId String?
  awardedBy   String?
  createdAt   DateTime @default(now())

  caravan     Caravan  @relation(fields: [caravanId], references: [id], onDelete: Cascade)

  @@unique([challengeId, caravanId])
  @@index([caravanId])
}

model MentorRating {
  id                       String   @id @default(uuid())
  mentorId                 String
  studentId                String
  ratingValue              Int      // 1 to 5
  guidanceFeedback         String?
  seasonEvaluationComments String?
  createdAt                DateTime @default(now())

  // Relations
  mentor                   User     @relation("RatingMentor", fields: [mentorId], references: [id], onDelete: Cascade)
  student                  User     @relation("RatingStudent", fields: [studentId], references: [id], onDelete: Cascade)

  @@index([mentorId])
  @@index([studentId])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  title     String
  message   String
  type      String   @default("alert") // "alert" | "reward" | "challenge"
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  // Relations
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([userId, createdAt])
}

// Versioned money rules, edited in the panel. The newest version is in force.
model EconomyPolicy {
  version   Int      @id @default(autoincrement())
  config    Json
  note      String?
  createdBy String
  createdAt DateTime @default(now())
}

// Every balance movement of every asset. Summing a user's rows gives their balance.
model AssetTransaction {
  id            String   @id @default(uuid())
  userId        String
  asset         String   // "zarik" | "nakh" | "farsh" | "beyragh"
  amount        Int
  sourceType    String   // what caused it, e.g. "submission_review", "conversion", "admin_adjust"
  sourceId      String?
  reason        String
  createdBy     String
  policyVersion Int
  createdAt     DateTime @default(now())

  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([sourceType, sourceId, userId, asset]) // the same payment cannot be made twice
  @@index([userId])
  @@index([asset])
  @@index([createdAt])
}

model ZarikTransaction {
  id        String   @id @default(uuid())
  userId    String
  amount    Int
  category  String   // "Quiz Rewards" | "Skill Tasks" | "Mentor Bonuses" | "Special Campaigns"
  reason    String
  createdBy String
  createdAt DateTime @default(now())

  // Relations
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([category])
  @@index([createdAt])
}

model AuditLog {
  id             String   @id @default(uuid())
  actorId        String
  actorName      String
  actorRole      String   @default("student") // STUDENT, MENTOR, SUPER_MENTOR, ADMIN
  action         String
  targetEntity   String
  targetEntityId String
  details        String
  ipAddress      String
  createdAt      DateTime @default(now())

  @@index([createdAt])
  @@index([action])
  @@index([actorId, createdAt])
}

model RolePermission {
  roleName             String   @id
  maskPhoneNumbers     Boolean  @default(false)
  restrictZarik        Boolean  @default(false)
  lockUserDeletions    Boolean  @default(false)
  manageContent        Boolean  @default(false)
  manageMentors        Boolean  @default(false)
  manageStudents       Boolean  @default(false)
  manageCaravans       Boolean  @default(false)
  manageSystem         Boolean  @default(false)
  canSendMessage       Boolean  @default(false)
  canJoinClasses       Boolean  @default(false)
  canScoreAndEvaluate  Boolean  @default(false)
  canConvertAssets     Boolean  @default(false)
  canCreateChallenges  Boolean  @default(false)
  canViewGlobalAnalytics Boolean @default(false)
  canManageUsers       Boolean  @default(false)
  canLoginPanel        Boolean  @default(false)
  permissionsJson      String?
}

model MediaAsset {
  id         String   @id @default(uuid())
  filename   String
  url        String
  mimeType   String
  size       Int
  assetType  String   @default("general") // "general" | "course_video" | "banner" | "avatar"
  title      String?
  instructor String?
  duration   Int?
  createdAt  DateTime @default(now())
}

model Certificate {
  id           String   @id @default(uuid())
  userId       String
  title        String
  verifyId     String
  issuedAt     DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders       PhysicalCertificateOrder[]
}

model PhysicalCertificateOrder {
  id             String   @id @default(uuid())
  userId         String
  certificateId  String
  recipientName  String
  postalAddress  String
  postalCode     String
  phoneNumber    String
  status         String   @default("PENDING_PRINT") // PENDING_PRINT, DISPATCHED
  trackingCode   String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user           User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  certificate    Certificate @relation(fields: [certificateId], references: [id], onDelete: Cascade)
}

model MentorDocument {
  id           String   @id @default(uuid())
  userId       String
  filename     String
  url          String
  mimeType     String
  category     String?  // EDUCATION, JOB, RESUME
  status       String   @default("pending") // pending | approved | rejected
  rejectReason String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model RewardRule {
  id        String   @id @default(uuid())
  key       String   @unique
  min       Int
  max       Int
  metadata  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model MentorRewardRule {
  id            String   @id @default(uuid())
  mentorId      String?  // If null, applies to all mentors
  caravanId     String?
  stationId     String?  // Refers to SubCourseStation id or Class id
  rewardType    String   // CHALLENGE | BONUS | QUIZ
  maxGrantLimit Int
  timeframe     String   // DAILY | PER_STATION | TOTAL
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([mentorId])
  @@index([caravanId])
}

// ==================== NEW LMS HIERARCHY ====================

model Station {
  id                  String   @id @default(uuid())
  title               String
  subtitle            String?
  description         String?
  stayDuration        String?
  animationCount      Int?     // number of animation episodes shown in the app (set by the admin)
  animationTitle      String?
  animationUrl        String?
  animationsJson      String?  // JSON array of multiple animation slides [{id, title, url, description}]
  iconUrl             String?
  orderIndex          Int      @default(0)
  releaseDate         DateTime?
  releaseTime         String?
  isLocked                Boolean  @default(false)
  status                  String   @default("active") // "active" | "locked"
  scheduledUnlockTime     DateTime?
  requirePreviousComplete Boolean  @default(false)
  targetCaravansJson      String?  // JSON array of caravan IDs, or null for all caravans
  scoringCriteriaJson     String?  // e.g. JSON storing rules for rewards
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  categories          ClassCategory[]
  challenges          Challenge[]
}

model ClassCategory {
  id         String   @id @default(uuid())
  stationId  String
  title      String
  orderIndex Int      @default(0)
  // Shown in the app's «مشخصات جلسه» tab, one block per category
  description  String?
  instructor   String?  // instructor names from the bank, joined by «،»
  handoutUrl   String?
  handoutTitle String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  station    Station        @relation(fields: [stationId], references: [id], onDelete: Cascade)
  sessions   ClassSession[]
}

model ClassSession {
  id                String   @id @default(uuid())
  categoryId        String
  title             String
  description       String?
  videoUrl          String?
  instructor        String?
  sessionDate       String?  // Shamsi date: e.g. "1405/07/02"
  sessionTime       String?  // Class time interval: e.g. "۱۸:۰۰ الی ۱۹:۳۰"
  handoutUrl        String?  // Session notes (جزوه) file link, shown in the app's "مشخصات جلسه" tab
  handoutTitle      String?
  minWatchThreshold Float    @default(70.0)
  minPassScore      Int      @default(0)
  maxZarikReward    Int      @default(0)
  maxPointsReward   Int      @default(0)
  orderIndex        Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  isDeleted         Boolean  @default(false)
  deletedAt         DateTime?

  category          ClassCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  quizzes           Quiz[]
  watchRecords      SessionWatchRecord[]
  videoBookmarks    VideoBookmark[]
  videoClips        VideoClip[]

  @@index([categoryId])
  @@index([orderIndex])
}

model VideoClip {
  id                  String       @id @default(uuid())
  sessionId           String
  title               String
  videoUrl            String
  coverImageUrl       String?      // preview picture shown before the video plays
  clipOrder           Int          @default(0)
  duration            Int?
  unlockDate          String?
  unlockTime          String?
  scheduledUnlockTime DateTime?
  isLocked            Boolean      @default(false)
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  session      ClassSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  quizzes      Quiz[]

  @@index([sessionId])
  @@index([clipOrder])
}

model VideoBookmark {
  id           String       @id @default(uuid())
  sessionId    String
  userId       String
  videoSeconds Int
  noteText     String
  createdAt    DateTime     @default(now())

  session      ClassSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([userId])
}

model Quiz {
  id           String   @id @default(uuid())
  sessionId    String
  clipId       String?
  title        String
  orderIndex   Int      @default(0)
  type         String   @default("MULTIPLE_CHOICE") // MULTIPLE_CHOICE, TEXT, FILE
  questionsJson String? // JSON array of questions
  rewardZarik  Int      @default(0)
  rewardNakh   Int      @default(0)
  rewardFarsh  Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  session      ClassSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  clip         VideoClip?   @relation(fields: [clipId], references: [id], onDelete: Cascade)
  submissions  QuizSubmission[]
}

model QuizSubmission {
  id              String   @id @default(uuid())
  quizId          String
  studentId       String
  mentorId        String?
  status          String   @default("PENDING")
  score           Int      @default(0)
  answersJson     String?  // The actual answers submitted
  submittedAt     DateTime @default(now())
  updatedAt       DateTime @updatedAt

  quiz            Quiz      @relation(fields: [quizId], references: [id], onDelete: Cascade)
  student         User      @relation("StudentQuizSubmissions", fields: [studentId], references: [id], onDelete: Cascade)
  mentor          User?     @relation("MentorQuizReviews", fields: [mentorId], references: [id], onDelete: SetNull)
  feedbacks       MentorFeedback[]

  @@index([quizId])
  @@index([studentId])
}

// Seconds a user kept the app open in the foreground, per day (Asia/Tehran). Shown to the mentor as an activity chart.
model UserUsageDay {
  id        String   @id @default(uuid())
  userId    String
  day       String   // "YYYY-MM-DD"
  seconds   Int      @default(0)
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, day])
  @@index([day])
}

// Activity per user per hour (Asia/Tehran), for the panel's charts (person page, آمار tab):
//   kind "app"   value = seconds the app was in the foreground
//   kind "open"  value = times the app was opened / brought back after a while
//   kind "video" value = seconds of class video played; refId = ClassSession id
//   kind "gvideo" value = seconds of a station gallery (نگارستان) video played; refId = Station id
//   kind "chat"  value = seconds in the chat; kind "area" value = seconds in one part of the app, refId = the part
//                (home | academy | station | challenges | market | profile | chat | other)
model UserActivityHour {
  id        String   @id @default(uuid())
  userId    String
  day       String   // "YYYY-MM-DD"
  hour      Int      // 0..23
  kind      String
  refId     String   @default("")
  value     Int      @default(0)
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, day, hour, kind, refId])
  @@index([day, kind])
}

// How one person watched one video of a station (a class part or a gallery video), from the app's player:
//   segments        merged [start, end] second ranges really played (seeking does not count) -> coveredSeconds
//   playSeconds     all the time it played, repeats included; plays = times it was started
model VideoWatch {
  id              String   @id @default(uuid())
  userId          String
  clipId          String
  kind            String   // "session" (VideoClip of a ClassSession) | "gallery" (StationAnimation)
  stationId       String   @default("")
  sessionId       String   @default("")
  title           String   @default("")
  durationSeconds Int      @default(0)
  segments        Json     @default("[]")
  coveredSeconds  Int      @default(0)
  playSeconds     Int      @default(0)
  plays           Int      @default(0)
  createdAt       DateTime @default(now())
  lastWatchedAt   DateTime @default(now())

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, clipId])
  @@index([stationId])
  @@index([userId, lastWatchedAt])
}

// What a person did in the mobile app, one row per action, shown on the person's page in the panel
// (entered a part of the app, watched a video, changed the picture / profile, sent a challenge answer ...).
model UserActivityLog {
  id        String   @id @default(uuid())
  userId    String
  type      String   // enter | open | login | logout | video | avatar | profile | password | challenge | quiz | ticket | exchange ...
  area      String   @default("")
  refId     String   @default("")
  label     String   @default("")
  seconds   Int      @default(0)
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([createdAt])
}

model SessionWatchRecord {
  id                String       @id @default(uuid())
  userId            String
  sessionId         String
  watchedPercentage   Float        @default(0.0)
  lastPositionSeconds Int          @default(0)
  watchedSeconds      Int          @default(0)
  lastWatchedAt       DateTime     @default(now())

  user              User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  session           ClassSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([userId, sessionId])
  @@index([userId])
}

model UserProgress {
  id           String   @id @default(uuid())
  userId       String
  trackType    String   // "skill" or "media"
  stationId    String
  sessionId    String
  clipId       String
  isWatched    Boolean  @default(false)
  quizPassed   Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, clipId])
  @@index([userId, trackType])
}



model MentorFeedback {
  id               String         @id @default(uuid())
  submissionId     String
  mentorId         String
  comment          String
  isPrivate        Boolean        @default(false)
  parentFeedbackId String?
  createdAt        DateTime       @default(now())

  submission       QuizSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  mentor           User                 @relation("MentorFeedbacks", fields: [mentorId], references: [id], onDelete: Cascade)
  replies          MentorFeedback[]      @relation("FeedbackReplies")
  parentFeedback   MentorFeedback?      @relation("FeedbackReplies", fields: [parentFeedbackId], references: [id])

  @@index([submissionId])
  @@index([mentorId])
}

model Blacklist {
  id        String   @id @default(uuid())
  type      String   // "ip" | "phone"
  value     String   @unique
  reason    String?
  createdAt DateTime @default(now())
}

model NotificationTemplate {
  id          String   @id @default(uuid())
  name        String   @unique
  titleTpl    String
  messageTpl  String
  channel     String   // "in_app" | "sms" | "email"
  createdAt   DateTime @default(now())
}

model NotificationLog {
  id             String   @id @default(uuid())
  templateId     String?
  channel        String
  targetAudience String
  status         String   // "success" | "failed"
  error          String?
  createdAt      DateTime @default(now())
}

model ChannelOverride {
  id        String   @id @default(uuid())
  channel   String   @unique // "sms" | "email" | "in_app"
  isEnabled Boolean  @default(true)
  updatedAt DateTime @updatedAt
}

model AdminMessage {
  id          String   @id @default(uuid())
  userId      String
  category    String   // "Mentor Complaint" | "System Bug" | "Financial Issue" | "General Suggestion"
  message     String
  status      String   @default("Pending") // "Pending" | "Investigating" | "Resolved"
  priority    String   @default("Normal") // "Normal" | "Urgent"
  adminReply  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
}

// A conversation. Caravan spaces take their members from the caravan itself; direct, support and
// media spaces use ChatMember. Unique key: "announcements", "caravan:<id>", "direct:<a>:<b>"...
model ChatSpace {
  id        String   @id @default(uuid())
  key       String   @unique
  type      String   // "announcements" | "public" | "mentors" | "caravan" | "challenges" | "media" | "direct" | "support"
  title     String
  caravanId String?
  lastSeq   Int      @default(0) // messages are numbered inside a space; unread = lastSeq - lastReadSeq
  slowSeconds Int     @default(0) // seconds between two messages of a member; 0 = off
  createdAt DateTime @default(now())

  caravan     Caravan?         @relation(fields: [caravanId], references: [id], onDelete: Cascade)
  members     ChatMember[]
  topics      ChatTopic[]
  supportCases SupportCase[]
  messages    ChatMessage[]
  attachments ChatAttachment[]

  @@index([type])
  @@index([caravanId])
}

// Per-user state in a space, and the membership of private spaces
model ChatMember {
  id          String    @id @default(uuid())
  spaceId     String
  userId      String
  role        String    @default("member") // "member" | "moderator"
  lastReadSeq Int       @default(0)
  muted       Boolean   @default(false)    // notifications off, chosen by the user
  mutedUntil  DateTime?                    // cannot post until then, set by a moderator
  createdAt   DateTime  @default(now())

  space ChatSpace @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  user  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([spaceId, userId])
  @@index([userId])
}

model ChatMessage {
  id              String    @id @default(uuid())
  spaceId         String
  seq             Int
  senderId        String?   // null for system and bot messages
  kind            String    @default("text") // "text" | "file" | "system" | "poll" | "challenge" | "station" | "result"
  botKey          String?   // the bot that wrote it
  meta            Json?     // card or poll content
  stationId       String?   // the station the conversation belongs to
  marks           String[]  @default([]) // "best" | "evidence", set by a moderator
  body            String    @default("")
  clientMessageId String?   // set by the client; a retry cannot post twice
  replyToId       String?
  threadRootId    String?   // one level only: replies under a top-level message
  threadReplies   Int       @default(0)
  mentions        String[]  @default([])
  pinnedAt        DateTime?
  editedAt        DateTime?
  deletedAt       DateTime?
  deletedBy       String?
  createdAt       DateTime  @default(now())

  space       ChatSpace        @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  sender      User?            @relation(fields: [senderId], references: [id], onDelete: SetNull)
  replyTo     ChatMessage?     @relation("ChatReply", fields: [replyToId], references: [id], onDelete: SetNull)
  replies     ChatMessage[]    @relation("ChatReply")
  attachments ChatAttachment[]
  reactions   ChatReaction[]
  topic       ChatTopic?
  tags        ChatMessageTag[]
  pollVotes   ChatPollVote[]
  reports     ChatReport[]

  @@unique([spaceId, seq])
  @@unique([senderId, clientMessageId])
  @@index([spaceId, threadRootId, seq])
}

model ChatReaction {
  id        String   @id @default(uuid())
  messageId String
  userId    String
  type      String   // "bravo" | "agree" | "idea" | "question" | "confused"
  createdAt DateTime @default(now())

  message ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId, type])
}

// A private file. It is served only through a signed link, never from /uploads.
model ChatAttachment {
  id         String   @id @default(uuid())
  spaceId    String
  messageId  String?  // null until the message that carries it is sent
  uploaderId String
  storageKey String
  name       String
  mime       String
  size       Int
  kind       String   // "image" | "audio" | "video" | "file"
  createdAt  DateTime @default(now())

  space   ChatSpace    @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  message ChatMessage? @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId])
}

model SupportTicket {
  id            String   @id @default(uuid())
  studentId     String
  category      String
  subject       String
  status        String   @default("open") // "open" | "resolved"
  ratingGiven   Int?
  voiceUrl      String?
  attachmentUrl String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  student       User     @relation("TicketStudent", fields: [studentId], references: [id], onDelete: Cascade)
  replies       SupportTicketReply[]

  @@index([studentId])
  @@index([status])
}

model SupportTicketReply {
  id            String   @id @default(uuid())
  ticketId      String
  mentorId      String?
  message       String
  voiceUrl      String?
  attachmentUrl String?
  createdAt     DateTime @default(now())

  ticket        SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  mentor        User?         @relation("ReplyMentor", fields: [mentorId], references: [id], onDelete: SetNull)
}
// ==================== DYNAMIC FORM ENGINE ====================

model DynamicForm {
  id             String   @id @default(uuid())
  title          String
  purpose        String?
  placement      String   // HOME_SCREEN_OVERLAY, AFTER_CLASS_SURVEY, MENTOR_EVALUATION, PROFILE_TAB, DRAWER_MENU
  targetAudience String   // ALL_USERS, STUDENTS_ONLY, MENTORS_ONLY, SPECIFIC_CARAVAN
  targetCaravanId String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  fields         FormField[]
  submissions    FormSubmission[]
}

model FormField {
  id          String   @id @default(uuid())
  formId      String
  type        String   // text, textarea, radio, checkbox, rating, file, date
  label       String
  isRequired  Boolean  @default(false)
  orderIndex  Int      @default(0)
  optionsJson String?  // JSON array for choice types
  createdAt   DateTime @default(now())

  form        DynamicForm @relation(fields: [formId], references: [id], onDelete: Cascade)
}

model FormSubmission {
  id          String   @id @default(uuid())
  formId      String
  userId      String
  answersJson String   // The user's answers mapped to field ids or labels
  submittedAt DateTime @default(now())

  form        DynamicForm @relation(fields: [formId], references: [id], onDelete: Cascade)
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([formId])
  @@index([userId])
}

model MentorEvaluation {
  id                  String   @id @default(uuid())
  studentId           String
  mentorId            String
  stationId           String?
  rating              Int      // 1 to 5
  responsivenessScore Int      // 1 to 5
  guidanceScore       Int      // 1 to 5
  feedbackText        String?
  createdAt           DateTime @default(now())

  student             User     @relation("EvaluationsStudent", fields: [studentId], references: [id], onDelete: Cascade)
  mentor              User     @relation("EvaluationsMentor", fields: [mentorId], references: [id], onDelete: Cascade)

  @@index([mentorId])
  @@index([studentId])
}

model PrivateStudentNote {
  id        String   @id @default(uuid())
  mentorId  String
  studentId String
  noteText  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  mentor    User     @relation("MentorNotes", fields: [mentorId], references: [id], onDelete: Cascade)
  student   User     @relation("StudentNotes", fields: [studentId], references: [id], onDelete: Cascade)

  @@index([mentorId])
  @@index([studentId])
}

model NewsArticle {
  id             String   @id @default(uuid())
  title          String
  subtitle       String?
  body           String
  imageUrl       String?
  reporter       String?  // منبع یا گزارشگر
  targetAudience String   @default("ALL") // "ALL", "STUDENTS", "MENTORS", specific caravan
  category       String?  // e.g. اطلاعیه, رویداد, آموزشی
  publishDate    DateTime @default(now())
  isPublished    Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Banner {
  id          String   @id @default(uuid())
  title       String
  imageUrl    String
  targetRoute String?  // e.g. "bazaar", "home", or external URL
  position    String   @default("bazaar_top") // e.g. bazaar_top, home_slider
  isActive    Boolean  @default(true)
  orderIndex  Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Instructor {
  id          String   @id @default(uuid())
  name        String
  nationalId  String?
  phoneNumber String?
  degree      String?  // مدرک تحصیلی
  resume      String?  // سوابق و رزومه
  description String?  // توضیحات و بیوگرافی
  classes     String?  // کلاس‌ها و دوره‌هایی که تدریس می‌کند
  avatarUrl   String?  // تصویر / عکس استاد
  isActive    Boolean  @default(true)
  orderIndex  Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// A challenge card in a conversation. One per challenge, space and (personal challenges) recipient.
model ChatTopic {
  id           String    @id @default(uuid())
  scopeKey     String    @unique // "<challengeId>:<spaceId>:<recipientId or empty>"
  messageId    String    @unique
  spaceId      String
  challengeId  String
  recipientId  String?
  status       String    @default("open") // "open" | "closed" | "paid"
  closedAt     DateTime?
  closedBy     String?
  finalMessageId String?  // the message chosen as the group's final answer
  reminderSent Boolean   @default(false)
  createdAt    DateTime  @default(now())

  message     ChatMessage           @relation(fields: [messageId], references: [id], onDelete: Cascade)
  space       ChatSpace             @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  challenge   Challenge             @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  evaluations ChallengeEvaluation[]
  insight     TopicInsight?

  @@index([challengeId])
}

model ChatTag {
  id         String    @id @default(uuid())
  name       String
  color      String
  spaceId    String?   // null = usable everywhere (admins and channel managers)
  visibility String    @default("public") // "public" | "staff"
  createdBy  String
  archivedAt DateTime? // a used tag is archived, so that old reports keep working
  createdAt  DateTime  @default(now())

  messages ChatMessageTag[]

  @@index([spaceId])
}

model ChatMessageTag {
  messageId String
  tagId     String
  createdBy String

  message ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  tag     ChatTag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([messageId, tagId])
}

model ChatPollVote {
  messageId String
  userId    String
  option    Int

  message ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@id([messageId, userId])
}

model ChatReport {
  id         String    @id @default(uuid())
  messageId  String
  reporterId String
  reason     String
  status     String    @default("open") // "open" | "resolved"
  resolvedBy String?
  createdAt  DateTime  @default(now())

  message ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@unique([messageId, reporterId])
  @@index([status])
}

model ChatScheduledMessage {
  id        String   @id @default(uuid())
  spaceId   String
  body      String
  sendAt    DateTime
  status    String   @default("pending") // "pending" | "sent" | "cancelled"
  createdBy String
  createdAt DateTime @default(now())

  @@index([status, sendAt])
}

// Bot switches. A bot without a row uses its default.
model ChatBot {
  key      String  @id
  enabled  Boolean @default(true)
  settings Json?
}

// What the worker already did for a station, so nothing is announced twice
model StationEvent {
  key       String   @id // "opened:<stationId>", "closing:<stationId>", "report:<stationId>"
  createdAt DateTime @default(now())
}

// A student's standing when a station ended
model StationReport {
  id        String   @id @default(uuid())
  stationId String
  userId    String
  capital   Int
  rank      Int
  createdAt DateTime @default(now())

  @@unique([stationId, userId])
}

// One matter a user raised with support; its messages are in the user's support space
model SupportCase {
  id         String    @id @default(uuid())
  spaceId    String
  userId     String
  subject    String
  category   String    @default("general")
  status     String    @default("open") // "open" | "reviewing" | "resolved"
  assigneeId String?
  rating     Int?
  fromSeq    Int       @default(0)
  resolvedAt DateTime?
  createdAt  DateTime  @default(now())

  space ChatSpace @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  user  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([userId])
}

model ChallengeEvaluation {
  id         String    @id @default(uuid())
  topicId    String
  userId     String
  criteria   Json      // { relevance, quality, collaboration, initiative }, 0 to 100
  score      Int
  share      Int       // percent of the conversation's participation
  suggested  Int
  finalNakh  Int
  status     String?   // "flagbearer" | "active" | "semi" | "companion" | "tired": the mentor's participation verdict
  reason     String?
  flags      String[]  @default([])
  objection  String?
  objectionStatus String?  // "pending" | "accepted" | "rejected"
  objectionResponse String?
  paidAt     DateTime?
  updatedAt  DateTime  @updatedAt

  topic ChatTopic @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@unique([topicId, userId])
}

// A caravan's official work in an inter-group challenge
model InterGroupEntry {
  id          String   @id @default(uuid())
  challengeId String
  caravanId   String
  anonCode    Int      // shown to judges instead of the caravan
  body        String
  fileUrl     String?
  submittedBy String
  submittedAt DateTime @default(now())

  scores InterGroupJudgeScore[]

  @@unique([challengeId, caravanId])
  @@unique([challengeId, anonCode])
}

model InterGroupJudgeScore {
  id         String @id @default(uuid())
  entryId    String
  judgeId    String
  score      Int
  strength   String
  suggestion String

  entry InterGroupEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)

  @@unique([entryId, judgeId])
}

// Participation of one member in an inter-group challenge, confirmed by the mentor or the admin.
// Current values: "flagbearer" | "active" | "semi" | "companion" | "tired" (older rows: "full" | "partner" | "minimal" | "inactive")
model InterGroupMemberTier {
  id          String  @id @default(uuid())
  challengeId String
  caravanId   String
  userId      String
  tier        String
  confirmedBy String?

  @@unique([challengeId, userId])
  @@index([challengeId, caravanId])
}

// Questions go to the judges privately; the answer is published for every caravan
model InterGroupQuestion {
  id          String   @id @default(uuid())
  challengeId String
  caravanId   String
  userId      String
  body        String
  answer      String?
  createdAt   DateTime @default(now())

  @@index([challengeId])
}

model TopicInsight {
  id        String   @id @default(uuid())
  topicId   String   @unique
  provider  String
  content   Json
  createdAt DateTime @default(now())

  topic ChatTopic @relation(fields: [topicId], references: [id], onDelete: Cascade)
}

/// Unfinished challenge / station forms an admin saved to finish later (one row per admin, kind and item;
/// key is "new" for a form that has not been created yet, else the id of the item being edited).
model AdminDraft {
  id        String   @id @default(uuid())
  ownerId   String
  kind      String
  key       String
  data      Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([ownerId, kind, key])
  @@index([ownerId, kind])
}
