<?xml version="1.0" encoding="utf-8"?>
<!--
  Network Security Config
  -----------------------
  - All traffic to the public internet MUST use HTTPS.
  - Cleartext (HTTP) is permitted ONLY for local development hosts:
      * 10.0.2.2        -> Android Emulator loopback to host machine
      * localhost       -> device-local embedded server
      * 192.168.100.51  -> LAN dev server (update if your IP changes)
  Remove or narrow this list before shipping to production.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">192.168.100.51</domain>
    </domain-config>
</network-security-config>
