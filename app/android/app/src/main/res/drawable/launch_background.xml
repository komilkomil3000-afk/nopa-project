<?xml version="1.0" encoding="utf-8"?>
<!-- Launch screen: the app's own background (assets/images/login_bg.png), not a flat colour.
     The logo is drawn by the first Flutter screen on this same background. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/splash_background" />
    <item>
        <bitmap
            android:gravity="fill"
            android:filter="true"
            android:src="@drawable/splash_bg" />
    </item>
</layer-list>
